+// fifo-fix-exact/src/Utils/CommitQueue.h
+//
+// GREEN phase. FIFO head-of-line blocking selector: the FIFO portion of Valve's
+// pinned commit 77f3d88a2c14b1e064bb3ec52380bfb46560b0b7.
+//
+// The upstream selector also gates on relative present-timing targets, but this
+// baseline predates those interfaces, so only the FIFO portion is reproduced: a
+// FIFO commit is Blocked while any earlier same-surface FIFO commit is still
+// unlatched (and not abandoned). Fence completion order does not imply
+// submission order, which is exactly why a later commit may latch ("done")
+// before an earlier one -- the selector must not report it Ready then.
+//
+// The ordering regression in ../commit-queue-regression.cpp pins this down.
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+
+namespace gamescope::CommitQueue
+{
+
+enum class SelectionResult
+{
+	Missing,
+	Blocked,
+	Ready,
+};
+
+// Look up commitID in the recorded queue (submission order preserved).
+//
+// Returns:
+//   { Missing, queue.end() } -- commitID was never recorded
+//   { Blocked, iterator    } -- an earlier same-surface FIFO commit is still
+//                              unlatched, so completion order must not be
+//                              mistaken for submission order
+//   { Ready,   iterator    } -- commitID was found and is not blocked
+//
+// The iterator points at the matching queue entry so callers can reuse the real
+// handle_done_commit() loop and erase() exactly as before.
+template <typename Queue>
+auto Select( Queue &queue, uint64_t commitID )
+	-> std::pair<SelectionResult, typename Queue::iterator>
+{
+	auto it = std::find_if( queue.begin(), queue.end(), [commitID]( const auto &commit )
+	{
+		return commit->commitID == commitID;
+	} );
+
+	if ( it == queue.end() )
+		return std::make_pair( SelectionResult::Missing, it );
+
+	// Fence completion order does not imply submission order, which FIFO needs.
+	const bool blocked = (*it)->fifo && std::any_of( queue.begin(), it, [&]( const auto &commit )
+	{
+		return commit->surf == (*it)->surf && commit->fifo && !commit->done && !commit->abandoned;
+	} );
+
+	return std::make_pair( blocked ? SelectionResult::Blocked : SelectionResult::Ready, it );
+}
+
