#!/usr/bin/bash
set -euo pipefail

steam_args=()
if [[ ${1:-} == "--desktop" ]]; then
    shift
    steam_args=(-steamdeck)
elif [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    # gamescope numbers its sockets by start order; this name is fixed
    ln -sfn "${GAMESCOPE_WAYLAND_DISPLAY}" "${XDG_RUNTIME_DIR}/gamescope-primary"
fi

steam_root="${STEAM_ROOT:-${HOME}/.local/share/Steam}"
steam_arm_dir="${steam_root}/steamrtarm64"
steam_arm="${steam_arm_dir}/steam"
steam_shim_dir="${steam_root}/lib/aarch64-linux-gnu"
steam_runtime_bin="${steam_root}/steam-runtime-steamrt-arm64/bin"

if [[ ! -x "${steam_arm}" ]]; then
    echo "ERROR: native ARM Steam is missing or not executable: ${steam_arm}" >&2
    exit 127
fi

steam_ld_path="${steam_arm_dir}"
if [[ -d "${steam_shim_dir}" ]]; then
    steam_ld_path="${steam_ld_path}:${steam_shim_dir}"
fi
export LD_LIBRARY_PATH="${steam_ld_path}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
if [[ -d "${steam_runtime_bin}" ]]; then
    export PATH="${steam_runtime_bin}:${PATH}"
fi
export FUSERMOUNT_PROG=/run/host/usr/bin/fusermount3
# Steam restores these for compat tools, which otherwise start with no PATH
export SYSTEM_PATH="${PATH}"
export SYSTEM_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
export STEAMLINK_V4L2_RESET_AFTER_LAST_BUF=1

# prune the Proton 11 registration earlier releases wrote; the internal-name
# match keeps user-created tool dirs safe
proton11_reg="${steam_root}/compatibilitytools.d/proton-11-arm64"
if grep -q '"proton11_arm64"' "${proton11_reg}/compatibilitytool.vdf" 2>/dev/null; then
    rm -f "${proton11_reg}/compatibilitytool.vdf"
    rmdir "${proton11_reg}" 2>/dev/null || true
fi

touch "${steam_root}/.cef-enable-remote-debugging"
cd "${steam_arm_dir}"

# Steam exits 42 when it wants to restart itself.  Supervise it inside this
# Gamescope session so only that request is absorbed; every other status is
# propagated unchanged and termination is never answered with a relaunch.
child_pid=
pending_signal=0

forward_signal() {
    # $1: numeric signal, $2: name for kill -s
    pending_signal=$1
    if [[ -n ${child_pid} ]]; then
        kill -s "$2" "${child_pid}" 2>/dev/null || true
    fi
}

trap 'forward_signal 15 TERM' TERM
trap 'forward_signal 2 INT' INT
trap 'forward_signal 1 HUP' HUP

while (( pending_signal == 0 )); do
    "${steam_arm}" \
        "${steam_args[@]}" \
        "$@" &
    child_pid=$!

    # A signal between fork and assignment still has to reach the child.
    if (( pending_signal != 0 )); then
        kill -s TERM "${child_pid}" 2>/dev/null || true
    fi

    # Re-wait after a forwarded signal until the child is really gone, so it is
    # always reaped and never relaunched.
    status=0
    while :; do
        status=0
        wait "${child_pid}" || status=$?
        if (( pending_signal != 0 )) && kill -0 "${child_pid}" 2>/dev/null; then
            continue
        fi
        break
    done
    child_pid=

    if (( pending_signal != 0 )); then
        exit $(( 128 + pending_signal ))
    fi
    if (( status == 42 )); then
        printf 'Steam requested a restart; relaunching\n' >&2
        continue
    fi
    exit "${status}"
done

exit $(( 128 + pending_signal ))
